# Copy to server/.env (chmod 600). Never commit .env.
# Fine-grained GitHub token, only this repo: Contents read/write, Issues read/write
GH_TOKEN=
# claude setup-token (Max subscription)
CLAUDE_CODE_OAUTH_TOKEN=
# YouTube OAuth (docs/setup.md). Empty refresh token = skip upload, keep the mp4.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_PRIVACY=private
# Dead-man switch ping URL (healthchecks.io free plan). Emails you if no run for 4 days.
HC_URL=
